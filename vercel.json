{
  "version": 2,
  "outputDirectory": "dist/hazlotu-frontend/browser",
  "functions": {
    "api/remove-bg.mjs": {
      "includeFiles": "node_modules/@imgly/background-removal-node/dist/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/$1.mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}